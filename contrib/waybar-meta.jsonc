// A second waybar bar (waybar's config may be a JSON array of bars): a narrow
// sidebar on one output listing every meta workspace with its agent status.
// Drop this object into your config array and the CSS into style.css.
{
    "name": "meta",
    "output": "HDMI-A-1",
    "layer": "top",
    "position": "right",
    "width": 230,
    "spacing": 0,
    "modules-left": ["custom/hyprmeta"],
    "custom/hyprmeta": {
        "exec": "/home/USER/.local/bin/hyprmeta agents --waybar --follow",
        "return-type": "json",
        "restart-interval": 5,
        "tooltip": true,
        "on-click": "/home/USER/.local/bin/hyprmeta pick"
    }
}

